# llm-console on the home LAN (192.168.1.0/24), where most devices are not on the
# tailnet: llm-console-lan.service (socat) listens on LAN_ADDRESS:LAN_PORT and
# forwards each connection to the web app. From the LAN: http://192.168.1.40/
#
# raspy gets this address by DHCP on wlan0: if it changes, update it here and run
# ./deploy.sh (install.sh refuses an address raspy does not have).
LAN_ADDRESS=192.168.1.40
LAN_PORT=80
# Where the web app listens on raspy: PublishPort in llm-console.container.
APP_ADDRESS=127.0.0.1:80
